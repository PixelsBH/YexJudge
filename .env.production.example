# Copy outside Git to a protected deployment config. Values are literal KEY=value;
# do not source this file, put credentials here, or merge the development Compose.
# All blank entries below are REQUIRED and deliberately have no usable defaults.
# Use reviewed, pre-pulled Linux images; tags alone are rejected by verification.
SERVER_IMAGE=
PROXY_IMAGE=
RUNTIME_IMAGE=
C_COMPILER_IMAGE=
CPP_COMPILER_IMAGE=
GO_COMPILER_IMAGE=
JAVA_COMPILER_IMAGE=

# Examples only: judge.example.com,judge.example.com:9443 (exact DNS hosts).
# No wildcard, IP literal, scheme, trailing dot, whitespace, or browser Origin.
ALLOWED_HOSTS=
# Stage with 127.0.0.1; expose a chosen host address only after firewall review.
TLS_BIND_IP=127.0.0.1
# Existing directory outside the checkout, e.g. /srv/yexjudge/workspaces.
# Must be owned by 10001:10001 with mode 0700, on a quota/bounded filesystem.
HOST_WORKSPACE_ROOT=
# Numeric GID from the dedicated host's /var/run/docker.sock (NOT a guessed GID).
DOCKER_SOCKET_GID=

# Absolute files supplied by a protected host secret store outside the checkout.
# Directory 0750 root:10001, files 0640 root:10001; no symlinks/world access.
SERVICE_CREDENTIALS_SOURCE=
DATABASE_URL_SOURCE=
MIGRATION_DATABASE_URL_SOURCE=
PG_CA_SOURCE=
TLS_CERT_SOURCE=
TLS_KEY_SOURCE=

# Fixed safety settings and limits live in the production manifest, not this file.
# Keep admissions disabled until all launch gates and staging verification pass.
# Docker/endpoint regression tests require true on an isolated staging deployment.
ACCEPT_SUBMISSIONS=false

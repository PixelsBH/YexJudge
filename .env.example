# Local development configuration. Copy this file to .env and adjust values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yexjudge?sslmode=disable
PORT=8080
QUEUE_POLL_INTERVAL_MS=500
QUEUE_LEASE_MS=60000
QUEUE_RECOVERY_INTERVAL_MS=1000
QUEUE_MAX_ATTEMPTS=3
SUBMIT_TIMEOUT_MS=10000
POSTGRES_PASSWORD=

# Deployment settings (Docker or rootless Podman Compose).
# For rootless Podman, set CONTAINER_SOCKET to:
# /run/user/<your-uid>/podman/podman.sock
# Workspace must be an absolute path; it is mounted at the same path in the
# server container so the runtime can bind-mount submission workspaces.
CONTAINER_SOCKET=/var/run/docker.sock
WORKSPACE_DIR=/absolute/path/to/yexjudge/workspaces

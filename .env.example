# Local development configuration. Copy this file to .env and adjust values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yexjudge?sslmode=disable
PORT=8080
QUEUE_POLL_INTERVAL_MS=500
QUEUE_LEASE_MS=60000
QUEUE_RECOVERY_INTERVAL_MS=1000
QUEUE_MAX_ATTEMPTS=3
SUBMIT_TIMEOUT_MS=10000
POSTGRES_PASSWORD=

# Compose deployment only.
#
# CONTAINER_SOCKET is the container API socket bind-mounted as the Docker socket
# YexJudge's client connects to. Use the path for your runtime:
#   Podman (rootless): /run/user/$(id -u)/podman/podman.sock
#   Docker:            /var/run/docker.sock
# The socket must exist and be running before "docker compose up".
CONTAINER_SOCKET=/var/run/docker.sock

# WORKSPACE_DIR is the host directory holding submission workspaces. It must be
# an absolute path and is mounted at the same location inside the server
# container, because the host runtime bind-mounts it for compile/runtime
# sandboxes.
WORKSPACE_DIR=/home/pixels/.local/share/yexjudge/workspaces
